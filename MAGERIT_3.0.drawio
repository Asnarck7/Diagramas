        <mxCell id="KCv0X93PMlT7swgnsqiF-60" value="&amp;nbsp;La meta es" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="KCv0X93PMlT7swgnsqiF-58">
