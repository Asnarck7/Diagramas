          </mxGeometry>
        </mxCell>
        <mxCell id="KCv0X93PMlT7swgnsqiF-56" value="lo importante no es que nunca haya un problema, sino que los usuarios&amp;nbsp;confíen en que todo está bajo control." style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
