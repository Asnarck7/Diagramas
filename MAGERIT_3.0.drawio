        <mxCell id="KCv0X93PMlT7swgnsqiF-32" value="r El peligros y qué oportunidades trae el uso de la tecnología (informática)." style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-735" y="797.5" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="KCv0X93PMlT7swgnsqiF-34" value="&lt;br&gt;solo de ver el riesgo de la tecnología por separado, sino de &lt;b&gt;incluirlo en el panorama general&lt;/b&gt; de todos los riesgos del organismo. De esta manera, los directivos pueden tomar las &lt;b&gt;mejores decisiones&lt;/b&gt; de forma equilibrada y &lt;b&gt;confiar&lt;/b&gt; en que los sistemas funcionarán como se espera.&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-745" y="917.5" width="220" height="130.5" as="geometry" />
        </mxCell>
        <mxCell id="KCv0X93PMlT7swgnsqiF-57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="KCv0X93PMlT7swgnsqiF-49" target="KCv0X93PMlT7swgnsqiF-56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KCv0X93PMlT7swgnsqiF-59" value="Aunque la tecnología puede fallar" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="KCv0X93PMlT7swgnsqiF-57">
