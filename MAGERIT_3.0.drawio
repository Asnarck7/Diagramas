          </mxGeometry>
        </mxCell>
        <mxCell id="KCv0X93PMlT7swgnsqiF-49" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Los ciudadanos esperan que los sistemas informáticos &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;funcionen bien&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; y hagan lo que se supone que deben hacer.&lt;/span&gt;&lt;/p&gt;" style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-473.75" y="675" width="177.5" height="72.5" as="geometry" />
        </mxCell>
        <mxCell id="KCv0X93PMlT7swgnsqiF-53" value="saber de antemano qué puede salir mal (los riesgos) y tener un plan para solucionarlo" style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
